<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartQuietCinema.Maui.ViewModels"
             xmlns:uiModels="clr-namespace:SmartQuietCinema.Maui.Models"
             xmlns:models="clr-namespace:SmartQuietCinema.Core.Models;assembly=SmartQuietCinema.Core"
             x:Class="SmartQuietCinema.Maui.MainPage"
             x:DataType="viewModels:MainPageViewModel">

    <!-- Main page layout -->
    <Grid>

        <!-- Main scrollable content -->
        <ScrollView>

            <VerticalStackLayout
                Padding="30,30,30,105"
                Spacing="20">

                <!-- Application title -->
                <Label
                    Text="{Binding Localization[AppTitle]}"
                    FontSize="28"
                    FontAttributes="Bold" />

                <!-- Audio output device selection -->
                <Label
                    Text="{Binding Localization[AudioOutputDevice]}"
                    FontAttributes="Bold" />

                <Picker
                    Title="{Binding Localization[SelectAudioDevice]}"
                    ItemsSource="{Binding OutputDevices}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:AudioOutputDevice}"
                    SelectedItem="{Binding SelectedOutputDevice}"
                    HorizontalOptions="Fill" />

                <!-- Audio capture diagnostic controls -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <Button
                        Grid.Column="0"
                        Text="{Binding Localization[StartCapture]}"
                        Command="{Binding StartCaptureCommand}" />

                    <Button
                        Grid.Column="1"
                        Text="{Binding Localization[StopCapture]}"
                        Command="{Binding StopCaptureCommand}" />

                </Grid>

                <!-- Capture status and statistics -->
                <Label
                    Text="{Binding CaptureStatus}"
                    FontAttributes="Bold" />

                <Label
                    Text="{Binding CapturedBytesText}"
                    FontSize="14" />

                <!-- Compression controls -->
                <Label
                    Text="{Binding Localization[CompressionLevel]}" />

                <Slider
                    Minimum="0"
                    Maximum="100"
                    Value="50" />

                <!-- Audio processing controls -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="15">

                    <Label
                        Grid.Column="0"
                        Text="{Binding Localization[AudioProcessing]}"
                        VerticalOptions="Center" />

                    <Switch
                        Grid.Column="1"
                        IsToggled="False"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Apply settings -->
                <Button
                    Text="{Binding Localization[ApplySettings]}" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- Floating language selection toolbar -->
        <Grid
            ZIndex="1"
            HeightRequest="77"
            ColumnDefinitions="Auto,Auto"
            ColumnSpacing="8"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,8">

            <!-- Scrollable language selection menu -->
            <Border
                Grid.Column="0"
                IsVisible="{Binding IsLanguageMenuOpen}"
                MaximumWidthRequest="326"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="#303035"
                Stroke="#555555"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="5">

                <CollectionView
                    ItemsSource="{Binding Languages}"
                    HeightRequest="65"
                    ItemSizingStrategy="MeasureFirstItem"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Default"
                    VerticalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Horizontal"
                            ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="uiModels:LanguageOption">

                            <!-- Language button and scrollbar clearance -->
                            <Grid
                                WidthRequest="58"
                                HeightRequest="65"
                                RowDefinitions="45,20">

                                <Button
                                    Grid.Row="0"
                                    Text="{Binding DisplayCode}"
                                    WidthRequest="58"
                                    HeightRequest="45"
                                    FontSize="14"
                                    Padding="4,0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start"
                                    Command="{Binding
                                        x:DataType='viewModels:MainPageViewModel',
                                        Source={RelativeSource
                                            AncestorType={x:Type viewModels:MainPageViewModel}},
                                        Path=ChangeLanguageCommand}"
                                    CommandParameter="{Binding CultureCode}"
                                    SemanticProperties.Description="{Binding NativeName}" />

                            </Grid>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Border>

            <!-- Current language button -->
            <Button
                Grid.Column="1"
                Text="{Binding SelectedLanguageCode}"
                WidthRequest="58"
                HeightRequest="45"
                FontSize="14"
                Padding="4,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,6,0,0"
                Command="{Binding ToggleLanguageMenuCommand}"
                SemanticProperties.Description="Select language" />

        </Grid>

    </Grid>

</ContentPage>
