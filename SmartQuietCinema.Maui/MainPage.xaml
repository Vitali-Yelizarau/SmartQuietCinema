<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartQuietCinema.Maui.ViewModels"
             x:Class="SmartQuietCinema.Maui.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             xmlns:models="clr-namespace:SmartQuietCinema.Core.Models;assembly=SmartQuietCinema.Core">

    <!-- Main content and fixed-height language toolbar -->
    <Grid RowDefinitions="*,78">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="30"
                                 Spacing="20">

                <Label
                    Text="{Binding Localization[AppTitle]}"
                    FontSize="28"
                    FontAttributes="Bold" />

                <!-- Audio output device selection -->
                <Label
                    Text="{Binding Localization[AudioOutputDevice]}"
                    FontAttributes="Bold" />

                <Picker
                    Title="{Binding Localization[SelectAudioDevice]}"
                    ItemsSource="{Binding OutputDevices}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:AudioOutputDevice}"
                    SelectedItem="{Binding SelectedOutputDevice}"
                    HorizontalOptions="Fill" />


                <!-- Audio capture diagnostic controls -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="{Binding Localization[StartCapture]}"
                            Command="{Binding StartCaptureCommand}" />

                    <Button Grid.Column="1"
                            Text="{Binding Localization[StopCapture]}"
                            Command="{Binding StopCaptureCommand}" />

                </Grid>

                <!-- Capture status and statistics -->
                <Label Text="{Binding CaptureStatus}"
                       FontAttributes="Bold" />

                <Label Text="{Binding CapturedBytesText}"
                       FontSize="14" />

                <Label Text="{Binding Localization[CompressionLevel]}" />

                <Slider
                    Minimum="0"
                    Maximum="100"
                    Value="50" />

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="15">

                    <Label Grid.Column="0"
                           Text="{Binding Localization[AudioProcessing]}"
                           VerticalOptions="Center" />  

                    <Switch Grid.Column="1"
                            IsToggled="False"
                            VerticalOptions="Center" />

                </Grid>

                <Button Text="{Binding Localization[ApplySettings]}" />
            </VerticalStackLayout>
        </ScrollView>



        <!-- Fixed-height language selection toolbar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              Padding="20,8,20,12">

            <!-- Available languages -->
            <!-- Scrollable language selection menu -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsLanguageMenuOpen}"
                    MaximumWidthRequest="309"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    BackgroundColor="#303035"
                    Stroke="#555555"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="5">

                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Always"
                            VerticalScrollBarVisibility="Never">

                    <HorizontalStackLayout Spacing="6">

                        <Button Text="EN"
                                WidthRequest="55"
                                HeightRequest="45"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en"
                                SemanticProperties.Description="English" />

                        <Button Text="RU"
                                WidthRequest="55"
                                HeightRequest="45"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="ru"
                                SemanticProperties.Description="Русский" />

                    </HorizontalStackLayout>

                </ScrollView>

            </Border>

            <!-- Current language button -->
            <Button Grid.Column="1"
                    Text="{Binding SelectedLanguageCode}"
                    WidthRequest="55"
                    HeightRequest="45"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Command="{Binding ToggleLanguageMenuCommand}"
                    SemanticProperties.Description="Select language" />

        </Grid>    

    </Grid>

</ContentPage>
