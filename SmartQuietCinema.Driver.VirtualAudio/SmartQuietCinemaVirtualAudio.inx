; Experimental render-only PortCls package adapted from the Microsoft SysVAD INF.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/20/2026,0.1.0.0
CatalogFile=SmartQuietCinemaVirtualAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22621

[Models.NTamd64.10.0...22621]
%DeviceDescription%=VirtualAudio,ROOT\SmartQuietCinemaVirtualAudio

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
SmartQuietCinemaVirtualAudio.sys=1

[DestinationDirs]
DriverFiles=13

[DriverFiles]
SmartQuietCinemaVirtualAudio.sys

[VirtualAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[VirtualAudio.NT.Interfaces]
AddInterface=%Audio%,%WaveName%,WaveInterface
AddInterface=%Render%,%WaveName%,WaveInterface
AddInterface=%Realtime%,%WaveName%,WaveInterface
AddInterface=%Audio%,%TopologyName%,TopologyInterface
AddInterface=%Topology%,%TopologyName%,TopologyInterface

[WaveInterface]
AddReg=WaveProperties

[WaveProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceDescription%

[TopologyInterface]
AddReg=TopologyProperties

[TopologyProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceDescription%
HKR,EP\0,%EndpointAssociation%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
; Exclude the experimental endpoint from default-device selection for both render roles.
HKR,EP\0,%NeverSetDefault%,0x00010001,0x105

[VirtualAudio.NT.Services]
AddService=SmartQuietCinemaVirtualAudio,0x00000002,VirtualAudioService

[VirtualAudioService]
DisplayName=%DeviceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SmartQuietCinemaVirtualAudio.sys

[VirtualAudio.NT.Wdf]
KmdfService=SmartQuietCinemaVirtualAudio,VirtualAudioFramework

[VirtualAudioFramework]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="SmartQuietCinema"
DeviceDescription="SmartQuietCinema Virtual Audio (Experimental)"
DiskName="SmartQuietCinema Experimental Virtual Audio"
WaveName="SqcVirtualWave"
TopologyName="SqcVirtualTopology"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
EndpointAssociation="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
NeverSetDefault="{F3E80BEF-1723-4FF2-BCC4-7F83DC5E46D4},3"
AnyNode="{00000000-0000-0000-0000-000000000000}"
