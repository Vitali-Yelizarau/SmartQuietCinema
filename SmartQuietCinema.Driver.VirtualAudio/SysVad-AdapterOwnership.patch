 #pragma code_seg()
+/// <summary>Reports whether the adapter still accepts new work for this device generation.</summary>
+_Use_decl_annotations_
+STDMETHODIMP_(BOOLEAN)
+CAdapterCommon::IsAvailable()
+{
+    return InterlockedCompareExchange(&m_ShutdownStarted, FALSE, FALSE) == FALSE;
+}
+
+/// <summary>Protects a short timer or ETW operation without extending the lifetime of an open stream.</summary>
+/// <returns>Whether the caller must finish the admitted operation with EndActivity.</returns>
+_Use_decl_annotations_
+STDMETHODIMP_(BOOLEAN)
+CAdapterCommon::TryBeginActivity()
+{
+    if (!IsAvailable() || !ExAcquireRundownProtection(&m_ActivityRundown)) return FALSE;
+    // Recheck so nothing is admitted between publishing shutdown and closing the rundown gate.
+    if (IsAvailable()) return TRUE;
+    EndActivity();
+    return FALSE;
+}
+
+/// <summary>Releases one activity acquired on an adapter the caller already keeps alive.</summary>
+_Use_decl_annotations_
+STDMETHODIMP_(VOID)
+CAdapterCommon::EndActivity()
+{
+    ExReleaseRundownProtection(&m_ActivityRundown);
+}
